# Inference gateway configuration — placeholders only, never real credentials.
#
# Copy to `.env` (git-ignored, never committed) and fill in:
#   cp .env.example .env
#
# The engine reads these at invocation time (internal/provider):
# FREELLMAPI_KEY is the gateway unified key; FREELLMAPI_BASE_URL selects
# the gateway endpoint. Defaults target a local gateway.
FREELLMAPI_KEY=freellmapi-REPLACE-ME
FREELLMAPI_BASE_URL=http://localhost:3001/v1
