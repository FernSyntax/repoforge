---
import Base from "../layouts/Base.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../site";

// FAQ entries ship as labeled placeholders: replace every question
// and answer with real content before publishing. The JSON-LD below
// mirrors exactly what is visible — no invented facts, no invented
// URLs (url fields are omitted until the deployment hostname exists).
const FAQ = [
  {
    question: "What does " + SITE_NAME + " do?",
    answer: "Replace this answer with one plain-language sentence about your product.",
  },
  {
    question: "Who is " + SITE_NAME + " for?",
    answer: "Replace this answer with your ideal customer profile in one sentence.",
  },
  {
    question: "How do I get started?",
    answer: "Replace this answer with the single first step a new visitor should take.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Base title={SITE_NAME} description={SITE_DESCRIPTION}>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading">{SITE_NAME}</h1>
    <p>{SITE_DESCRIPTION}</p>
    <a class="button" href="#contact">Get in touch</a>
  </section>

  <section aria-labelledby="brief-heading">
    <h2 id="brief-heading">In brief</h2>
    <p>
      {SITE_NAME}: {SITE_DESCRIPTION} This page answers what it is,
      who it serves, and how to start — written for readers and for
      answer engines alike.
    </p>
  </section>

  <section id="features" aria-labelledby="features-heading">
    <h2 id="features-heading">Features</h2>
    <ul class="features">
      <li>
        <h3>Static by default</h3>
        <p class="muted">
          No client-side JavaScript ships with this template. Add an
          island only where interactivity earns its weight.
        </p>
      </li>
      <li>
        <h3>Accessible markup</h3>
        <p class="muted">
          Landmarks, a skip link, visible focus, and reduced-motion
          support are built into the layout and styles.
        </p>
      </li>
      <li>
        <h3>Search-ready</h3>
        <p class="muted">
          Titles, descriptions, and Open Graph tags come from your
          project values — never from invented content.
        </p>
      </li>
    </ul>
  </section>

  <section id="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact</h2>
    <p>
      Replace this section with your own contact path: an email link,
      a form endpoint, or a scheduling page. The template ships no
      tracking and no third-party scripts.
    </p>
  </section>

  <section id="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently asked questions</h2>
    <dl>
      {
        FAQ.map((item) => (
          <>
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </>
        ))
      }
    </dl>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Base>
