#!/bin/sh
# check-issue-forms — validate the GitHub issue forms and the pull
# request template against the shape GitHub actually accepts.
#
# The failure this guards against is publishing a form that GitHub
# silently refuses to render: an empty required title, an unsupported
# field type, a missing label, a duplicate id. Every one of those is a
# broken front door for the people the project most needs to hear from.
#
# Checks per form:
#   - top-level name, description, and body
#   - every body item has a supported type and the fields that type
#     requires (id, attributes.label for askable types)
#   - input/textarea/dropdown ids are unique and non-empty
#   - validations is an object, and required is a boolean
#   - dropdown options is a non-empty list of strings
#   - no empty label anywhere
#
# Read-only. Exits 0 when every form is valid, 1 on the first problem.
set -eu

# cd must not print the target directory when CDPATH is set.
CDPATH=

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

if ! python3 -c 'import yaml' 2>/dev/null; then
	echo "check-issue-forms: PyYAML is not installed; cannot validate the forms." >&2
	echo "check-issue-forms: install PyYAML (pip install pyyaml) or let CI run this check." >&2
	exit 2
fi

exec python3 - "$@" <<'PY'
import sys
from pathlib import Path

import yaml

# The GitHub issue-form `type` values, and what each one requires.
ASKABLE = {"input", "textarea", "dropdown"}
KNOWN_TYPES = ASKABLE | {"markdown", "checkboxes"}
REQUIRED_FIELDS = {
    "input": {"id", "attributes"},
    "textarea": {"id", "attributes"},
    "dropdown": {"id", "attributes"},
    "markdown": {"attributes"},
    "checkboxes": {"id", "attributes"},
}

problems = []
# config.yml is not a form: it is the issue chooser configuration, and
# it is validated separately below.
forms = sorted(p for p in Path(".github/ISSUE_TEMPLATE").glob("*.yml") if p.name != "config.yml")
if not forms:
    problems.append("no issue forms found under .github/ISSUE_TEMPLATE/")

for form in forms:
    try:
        doc = yaml.safe_load(form.read_text())
    except yaml.YAMLError as exc:
        problems.append(f"{form}: invalid YAML: {exc}")
        continue
    if not isinstance(doc, dict):
        problems.append(f"{form}: the document is not a mapping")
        continue

    for key in ("name", "description", "body"):
        if not str(doc.get(key, "")).strip():
            problems.append(f"{form}: top-level {key!r} is missing or empty")

    body = doc.get("body")
    if not isinstance(body, list) or not body:
        problems.append(f"{form}: 'body' must be a non-empty list")
        continue

    seen_ids = set()
    for index, item in enumerate(body):
        where = f"{form}: body[{index}]"
        if not isinstance(item, dict):
            problems.append(f"{where}: not a mapping")
            continue
        kind = item.get("type")
        if kind not in KNOWN_TYPES:
            problems.append(f"{where}: unsupported type {kind!r} (want one of {sorted(KNOWN_TYPES)})")
            continue
        missing = REQUIRED_FIELDS[kind] - set(item)
        if missing:
            problems.append(f"{where}: {kind!r} item is missing {sorted(missing)}")
            continue
        if kind in ASKABLE:
            item_id = str(item.get("id", "")).strip()
            if not item_id:
                problems.append(f"{where}: 'id' must not be empty")
            if item_id in seen_ids:
                problems.append(f"{where}: duplicate id {item_id!r}")
            seen_ids.add(item_id)
        attrs = item.get("attributes")
        if not isinstance(attrs, dict):
            problems.append(f"{where}: 'attributes' must be a mapping")
            continue
        if kind in ASKABLE and not str(attrs.get("label", "")).strip():
            problems.append(f"{where}: attributes.label is missing or empty")
        if kind == "markdown" and not str(attrs.get("value", "")).strip():
            problems.append(f"{where}: markdown value is missing or empty")
        if kind == "dropdown":
            options = attrs.get("options")
            if not isinstance(options, list) or not options:
                problems.append(f"{where}: dropdown options must be a non-empty list")
            elif not all(isinstance(o, str) and o.strip() for o in options):
                problems.append(f"{where}: dropdown options must all be non-empty strings")
        validations = item.get("validations")
        if validations is not None:
            if not isinstance(validations, dict):
                problems.append(f"{where}: 'validations' must be a mapping")
            elif not isinstance(validations.get("required", False), bool):
                problems.append(f"{where}: validations.required must be a boolean")

# A form that files under a label the repository does not have is a
# broken front door with the failure deferred to filing time (a `gh`
# failure the author cannot fix). Form labels must name canonical
# labels. The canonical file is absent in minimal fixtures, where the
# check is skipped — never failed.
labels_file = Path("configs/github/labels.yaml")
if labels_file.is_file():
    try:
        labels_doc = yaml.safe_load(labels_file.read_text())
    except yaml.YAMLError as exc:
        problems.append(f"{labels_file}: invalid YAML: {exc}")
        labels_doc = None
    if isinstance(labels_doc, dict):
        canonical = set()
        for entry in labels_doc.get("labels", []):
            if isinstance(entry, dict):
                canonical.add(str(entry.get("name", "")).strip())
        for form in forms:
            try:
                form_doc = yaml.safe_load(form.read_text())
            except yaml.YAMLError:
                continue  # already reported above
            if not isinstance(form_doc, dict):
                continue
            declared = form_doc.get("labels", [])
            if not isinstance(declared, list):
                problems.append(f"{form}: top-level 'labels' must be a list")
                continue
            for label in declared:
                if str(label).strip() not in canonical:
                    problems.append(f"{form}: label {label!r} is not in the canonical label set ({labels_file})")

config = Path(".github/ISSUE_TEMPLATE/config.yml")
if not config.is_file():
    problems.append(".github/ISSUE_TEMPLATE/config.yml is missing (the issue chooser needs it)")
else:
    try:
        doc = yaml.safe_load(config.read_text())
    except yaml.YAMLError as exc:
        problems.append(f"{config}: invalid YAML: {exc}")
        doc = None
    if isinstance(doc, dict):
        if not isinstance(doc.get("blank_issues_enabled"), bool):
            problems.append(f"{config}: 'blank_issues_enabled' must be a boolean")
        links = doc.get("contact_links")
        if links is not None:
            if not isinstance(links, list) or not links:
                problems.append(f"{config}: 'contact_links' must be a non-empty list when present")
            else:
                for i, link in enumerate(links):
                    if not isinstance(link, dict):
                        problems.append(f"{config}: contact_links[{i}] must be a mapping")
                        continue
                    for key in ("name", "url", "about"):
                        if not str(link.get(key, "")).strip():
                            problems.append(f"{config}: contact_links[{i}].{key} is missing or empty")

pr_template = Path(".github/PULL_REQUEST_TEMPLATE.md")
if not pr_template.is_file():
    problems.append(".github/PULL_REQUEST_TEMPLATE.md is missing")
else:
    text = pr_template.read_text()
    for heading in ("## What changed", "## Why", "## Specification", "## Tests",
                    "## Validation", "## Risk", "## Documentation and ADRs",
                    "## Operational impact", "## Breaking / migration impact",
                    "## Known limitations"):
        if heading not in text:
            problems.append(f".github/PULL_REQUEST_TEMPLATE.md: missing section {heading!r}")

if problems:
    print("check-issue-forms: the issue forms or PR template are not valid:", file=sys.stderr)
    for p in problems:
        print(f"  - {p}", file=sys.stderr)
    sys.exit(1)

print(f"check-issue-forms: {len(forms)} issue form(s) and the PR template are valid")
PY
