# Binaries
/repoforge
/bin/
/dist/
*.test
*.exe

# Coverage and profiles
*.out
coverage.*
*.prof

# Local environment and credentials (never commit)
.env
.env.*
!.env.example
*.token

# Python runtime artifacts (dependencies stay virtualenv-local;
# orchestration/requirements.txt carries the hashed pins).
__pycache__/
*.py[cod]
.orchestration-venv/

# Product template install and build outputs (reproducible via the
# committed lockfile; never source, never committed).
product/astro/node_modules/
product/astro/dist/

# Generated template output (scripts/build-template default).
# Publication is automated by the Template Publication workflow; a local
# copy is a build artifact and is never committed.
/.template-out/
